    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const u = $('Normalize Telegram Update').item.json;\nconst s = Object.assign({}, $json);\nconst input = (u.callback_data || u.text || '').trim();\nconst lang = s.language === 'te' ? 'te' : 'en';\n\nconst T = {\n  en: {\n    askVisa: 'Please choose your visa type:',\n    askCountry: 'Which country do you want to travel to?',\n    askOther: 'Please type the name of the destination country:',\n    askName: 'Please enter your full name (as on passport):',\n    askDob: 'Please enter your date of birth (DD/MM/YYYY):',\n    askPassport: 'Please enter your passport number:',\n    askEmail: 'Please enter your email address:',\n    askPhone: 'Please enter your phone number with country code, starting with + (e.g. +919876543210):',\n    badCountry: 'That does not look like a valid country name. Please type letters only (min 3).',\n    badName: 'Invalid name. Use letters and spaces only, at least 3 characters.',\n    badDob: 'Invalid date. Please use DD/MM/YYYY and a real date in the past.',\n    badPassport: 'Invalid passport number. Use 6-9 letters/digits, e.g. A1234567.',\n    badEmail: 'Invalid email address. Please try again.',\n    badPhone: 'Invalid phone number. Country code is required - start with + followed by country code and number (e.g. +919876543210).',\n    useButtons: 'Please use the buttons below.',\n    review: 'Please review your details:',\n    confirmQ: 'Is everything correct?',\n    cancelled: 'Your application was cancelled. Send /start to begin again.',\n    submittedAlready: 'Your application has already been submitted (ID: {id}). Send /start to start a new one.',\n    success: 'Your visa application has been submitted successfully!\\n\\nApplication ID: <b>{id}</b>\\n\\nOur visa consultant will contact you soon.\\n\\nContact us: 8121819904',\n    labels: ['Visa type', 'Country', 'Full name', 'Date of birth', 'Passport', 'Email', 'Phone'],\n  },\n  te: {\n    askVisa: 'దయచేసి మీ వీసా రకాన్ని ఎంచుకోండి:',\n    askCountry: 'మీరు ఏ దేశానికి వెళ్లాలనుకుంటున్నారు?',\n    askOther: 'దయచేసి గమ్య దేశం పేరును టైప్ చేయండి:',\n    askName: 'దయచేసి మీ పూర్తి పేరును నమోదు చేయండి (పాస్‌పోర్ట్‌లో ఉన్నట్లు):',\n    askDob: 'దయచేసి మీ పుట్టిన తేదీని నమోదు చేయండి (DD/MM/YYYY):',\n    askPassport: 'దయచేసి మీ పాస్‌పోర్ట్ నంబర్‌ను నమోదు చేయండి:',\n    askEmail: 'దయచేసి మీ ఇమెయిల్ చిరునామాను నమోదు చేయండి:',\n    askPhone: 'దయచేసి మీ ఫోన్ నంబర్‌ను నమోదు చేయండి (+ తో ప్రారంభించి కంట్రీ కోడ్‌తో, ఉదా. +919876543210):',\n    badCountry: 'సరైన దేశం పేరు కాదు. అక్షరాలు మాత్రమే టైప్ చేయండి (కనీసం 3).',\n    badName: 'పేరు సరైనది కాదు. అక్షరాలు మరియు ఖాళీలు మాత్రమే, కనీసం 3 అక్షరాలు.',\n    badDob: 'తేదీ సరైనది కాదు. DD/MM/YYYY ఫార్మాట్‌లో గత తేదీని నమోదు చేయండి.',\n    badPassport: 'పాస్‌పోర్ట్ నంబర్ సరైనది కాదు. 6-9 అక్షరాలు/అంకెలు, ఉదా. A1234567.',\n    badEmail: 'ఇమెయిల్ చిరునామా సరైనది కాదు. మళ్ళీ ప్రయత్నించండి.',\n    badPhone: 'ఫోన్ నంబర్ సరైనది కాదు. కంట్రీ కోడ్ తప్పనిసరి - + తో ప్రారంభించండి (ఉదా. +919876543210).',\n    useButtons: 'దయచేసి క్రింది బటన్‌లను ఉపయోగించండి.',\n    review: 'దయచేసి మీ వివరాలను సమీక్షించండి:',\n    confirmQ: 'అన్నీ సరిగ్గా ఉన్నాయా?',\n    cancelled: 'మీ దరఖాస్తు రద్దు చేయబడింది. మళ్ళీ ప్రారంభించడానికి /start పంపండి.',\n    submittedAlready: 'మీ దరఖాస్తు ఇప్పటికే సమర్పించబడింది (ID: {id}). కొత్తది కోసం /start పంపండి.',\n    success: 'మీ వీసా దరఖాస్తు విజయవంతంగా సమర్పించబడింది!\\n\\nదరఖాస్తు ID: <b>{id}</b>\\n\\nమా వీసా కన్సల్టెంట్ త్వరలో మిమ్మల్ని సంప్రదిస్తారు.\\n\\nమమ్మల్ని సంప్రదించండి: 8121819904',\n    labels: ['వీసా రకం', 'దేశం', 'పూర్తి పేరు', 'పుట్టిన తేదీ', 'పాస్‌పోర్ట్', 'ఇమెయిల్', 'ఫోన్'],\n  },\n};\n\nconst VISA = { visa_tourist: 'Tourist', visa_student: 'Student', visa_work: 'Work', visa_business: 'Business' };\nconst COUNTRY = { c_usa: 'USA', c_uk: 'UK', c_canada: 'Canada', c_australia: 'Australia', c_germany: 'Germany' };\n\nlet route = 'text';\nlet reply = '';\nlet t = T[lang];\nlet application = null;\n\nfunction esc(v) { return String(v || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }\nfunction reviewText() {\n  const L = t.labels;\n  return t.review + '\\n\\n' +\n    '<b>' + L[0] + ':</b> ' + esc(s.visa_type) + '\\n' +\n    '<b>' + L[1] + ':</b> ' + esc(s.country) + '\\n' +\n    '<b>' + L[2] + ':</b> ' + esc(s.full_name) + '\\n' +\n    '<b>' + L[3] + ':</b> ' + esc(s.dob) + '\\n' +\n    '<b>' + L[4] + ':</b> ' + esc(s.passport) + '\\n' +\n    '<b>' + L[5] + ':</b> ' + esc(s.email) + '\\n' +\n    '<b>' + L[6] + ':</b> ' + esc(s.phone) + '\\n\\n' + t.confirmQ;\n}\nfunction validDob(v) {\n  const m = /^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/.exec(v);\n  if (!m) return false;\n  const d = +m[1], mo = +m[2], y = +m[3];\n  const dt = new Date(Date.UTC(y, mo - 1, d));\n  if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) return false;\n  const now = new Date();\n  return dt < now && y > now.getUTCFullYear() - 120;\n}\n\nswitch (s.current_step) {\n  case 'start': {\n    if (input === 'lang_en' || input === 'lang_te') {\n      s.language = input === 'lang_te' ? 'te' : 'en';\n      t = T[s.language];\n      s.current_step = 'choose_visa_type';\n      reply = t.askVisa; route = 'visa';\n    } else { reply = 'Please choose your language / దయచేసి మీ భాషను ఎంచుకోండి:'; route = 'language'; }\n    break;\n  }\n  case 'choose_visa_type': {\n    if (VISA[input]) {\n      s.visa_type = VISA[input];\n      s.current_step = 'choose_country';\n      reply = t.askCountry; route = 'country';\n    } else { reply = t.useButtons + '\\n\\n' + t.askVisa; route = 'visa'; }\n    break;\n  }\n  case 'choose_country': {\n    if (COUNTRY[input]) {\n      s.country = COUNTRY[input];\n      s.current_step = 'ask_full_name';\n      reply = t.askName;\n    } else if (input === 'c_other') {\n      s.current_step = 'ask_other_country';\n      reply = t.askOther;\n    } else { reply = t.useButtons + '\\n\\n' + t.askCountry; route = 'country'; }\n    break;\n  }\n  case 'ask_other_country': {\n    if (/^[A-Za-z][A-Za-z .'-]{2,55}$/.test(input)) {\n      s.country = input.replace(/\\s+/g, ' ');\n      s.current_step = 'ask_full_name';\n      reply = t.askName;\n    } else reply = t.badCountry;\n    break;\n  }\n  case 'ask_full_name': {\n    const v = input.replace(/\\s+/g, ' ');\n    if (/^[A-Za-z][A-Za-z .'-]{2,}$/.test(v) && v.replace(/[^A-Za-z]/g, '').length >= 3) {\n      s.full_name = v; s.current_step = 'ask_dob'; reply = t.askDob;\n    } else reply = t.badName;\n    break;\n  }\n  case 'ask_dob': {\n    if (validDob(input)) { s.dob = input; s.current_step = 'ask_passport'; reply = t.askPassport; }\n    else reply = t.badDob;\n    break;\n  }\n  case 'ask_passport': {\n    const v = input.toUpperCase().replace(/\\s+/g, '');\n    if (/^[A-Z0-9]{6,9}$/.test(v) && /[A-Z]/.test(v) && /\\d/.test(v)) {\n      s.passport = v; s.current_step = 'ask_email'; reply = t.askEmail;\n    } else reply = t.badPassport;\n    break;\n  }\n  case 'ask_email': {\n    const v = input.toLowerCase();\n    if (/^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/.test(v)) { s.email = v; s.current_step = 'ask_phone'; reply = t.askPhone; }\n    else reply = t.badEmail;\n    break;\n  }\n  case 'ask_phone': {\n    const v = input.replace(/[\\s()-]/g, '');\n    if (/^\\+[1-9]\\d{7,14}$/.test(v)) {\n      s.phone = v; s.current_step = 'review'; reply = reviewText(); route = 'review';\n    } else reply = t.badPhone;\n    break;\n  }\n  case 'review': {\n    if (input === 'review_confirm') {\n      const appId = 'VISA' + new Date().getFullYear() + String(Date.now()).slice(-6);\n      s.app_id = appId;\n      s.status = 'submitted';\n      s.current_step = 'submitted';\n      route = 'submit';\n      reply = t.success.replace('{id}', appId);\n      const parts = String(s.full_name || '').split(' ');\n      application = {\n        'Application ID': appId,\n        'Name': parts[0] || '',\n        'Surname': parts.slice(1).join(' '),\n        'DOB': s.dob,\n        'Mail ID': s.email,\n        'Phone number': s.phone,\n        'Passport Number': s.passport,\n        'DESTINATION COUNTRY': s.country,\n        'Visa Type': s.visa_type,\n        'Telegram Chat ID': String(u.chat_id),\n        'Telegram Username': s.username || '',\n        'Language': s.language || 'en',\n        'Submitted At': new Date().toISOString(),\n      };\n    } else if (input === 'review_edit') {\n      s.current_step = 'choose_visa_type';\n      reply = t.askVisa; route = 'visa';\n    } else if (input === 'review_cancel') {\n      s.current_step = 'start';\n      s.status = 'cancelled';\n      reply = t.cancelled;\n    } else { reply = reviewText(); route = 'review'; }\n    break;\n  }\n  case 'submitted': {\n    reply = t.submittedAlready.replace('{id}', s.app_id || '-');\n    break;\n  }\n  default: {\n    s.current_step = 'start';\n    reply = 'Please choose your language / దయచేసి మీ భాషను ఎంచుకోండి:'; route = 'language';\n  }\n}\n\ns.chat_id = String(u.chat_id);\ns.updated_at = new Date().toISOString();\nif (s.status !== 'submitted' && s.status !== 'cancelled') s.status = 'in_progress';\ndelete s.row_number;\n\nreturn {\n  chat_id: String(u.chat_id),\n  is_callback: u.is_callback,\n  callback_id: u.callback_id,\n  route,\n  reply_text: reply,\n  session: s,\n  application,\n};"
      },
